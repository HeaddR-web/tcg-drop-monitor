# Kopie als .env.local anlegen und die echten Werte eintragen.
# .env.local steht in .gitignore und gehoert NIE ins Repo.

# Telegram-Bot: Token bekommst du vom BotFather.
TG_BOT_TOKEN=123456789:AA-dein-token-hier

# Die Chat-ID deines eigenen Chats mit dem Bot.
# Ermitteln: dem Bot einmal schreiben, dann
#   curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
TG_CHAT_ID=123456789
